@model List<BirthdayReconRow>
@{
    ViewData["Title"] = "Đối soát điểm sinh nhật";
    var policies = ViewBag.Policies as List<BirthdayPolicy> ?? new();
    int? policyId = ViewBag.PolicyId as int?;
    var totalGranted = Model.Sum(r => r.Granted);
    var totalPoint = Model.Sum(r => r.PointGranted);
    var totalAmount = Model.Sum(r => r.AmountGranted);
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Đối soát điểm sinh nhật</h5>
    <a href="/BirthdayPolicy" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Về chương trình</a>
</div>

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted mb-0">Lọc theo chương trình</label>
            <select name="policyId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">— Tất cả chương trình —</option>
                @foreach (var p in policies)
                {
                    <option value="@p.Id" selected="@(policyId == p.Id)">@p.Code — @p.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Lọc</button></div>
    </form>
</div></div>

<div class="row g-2 text-center mb-3">
    <div class="col"><div class="card"><div class="card-body py-2"><div class="text-muted small">Lượt tặng</div><div class="fw-bold fs-5">@totalGranted</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body py-2"><div class="text-muted small">Điểm đã tặng</div><div class="fw-bold fs-5">@totalPoint.ToString("N0")</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body py-2"><div class="text-muted small">Tiền đã tặng</div><div class="fw-bold fs-5" style="color:#db2777">@totalAmount.ToString("N0")</div></div></div></div>
</div>

<div class="card"><div class="card-body">
    <table class="table table-hover align-middle mb-0">
        <thead><tr>
            <th>Chương trình</th><th>Loại thẻ</th>
            <th class="text-center">Lượt tặng</th><th class="text-end">Điểm đã tặng</th><th class="text-end">Tiền đã tặng</th>
        </tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td class="small"><span class="fw-semibold">@r.PolicyCode</span><div class="text-muted">@r.PolicyName</div></td>
                <td class="fw-semibold small">@r.CardType</td>
                <td class="text-center">@r.Granted</td>
                <td class="text-end">@r.PointGranted.ToString("N0")</td>
                <td class="text-end fw-bold" style="color:#db2777">@r.AmountGranted.ToString("N0")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr> }
        </tbody>
    </table>
</div></div>
