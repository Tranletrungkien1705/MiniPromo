@model CarPromotion
@{ ViewData["Title"] = Model.Name; var (t, css) = Ui.CarPromotion(Model.Status); }
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold mb-1">@Model.Name <span class="badge bg-@css ms-1">@t</span></h5>
                    <div class="text-muted small">Mã <b>@Model.Code</b> · Đại lý <b>@Model.DealerCode</b> · @Model.EffDateStart.ToString("dd/MM/yyyy") – @Model.EffDateEnd.ToString("dd/MM/yyyy")</div>
                    @if (!string.IsNullOrEmpty(Model.Remark)) { <div class="small mt-1">@Model.Remark</div> }
                </div>
                <div class="text-end">
                    @if (Model.Status == CarPromotionStatus.Pending) { <form asp-action="Approve" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-outline-primary">Duyệt</button></form> }
                    else if (Model.Status == CarPromotionStatus.Approved) { <form asp-action="Finish" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-success">Hoàn tất</button></form> }
                    @if (Model.Status == CarPromotionStatus.Pending || Model.Status == CarPromotionStatus.Approved) { <form asp-action="Cancel" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-outline-dark">Huỷ</button></form> }
                </div>
            </div>
            <div class="row g-2 text-center mt-2">
                <div class="col"><div class="text-muted small">Phạm vi</div><div class="fw-bold">@(Model.FlagAllModel ? "Tất cả model" : $"{Model.Details.Count} model")</div></div>
                <div class="col"><div class="text-muted small">Giá trị chung</div><div class="fw-bold" style="color:#db2777">@Ui.Money(Model.PointValAllModel)</div></div>
            </div>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2">Chi tiết theo model</h6>
            <table class="table table-sm align-middle">
                <thead><tr><th>Model</th><th class="text-end">Giá trị khuyến mại</th><th>Ghi chú</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Details)
                {
                    <tr><td class="fw-semibold small">@d.ModelCode</td><td class="text-end">@Ui.Money(d.PointVal)</td><td class="small text-muted">@d.Remark</td></tr>
                }
                @if (Model.Details.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-3">@(Model.FlagAllModel ? "Áp dụng tất cả model — không cần dòng chi tiết." : "Chưa có dòng model.")</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Thêm dòng model</h6>
            <form asp-action="AddDetail" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-2"><input name="modelCode" class="form-control form-control-sm text-uppercase" placeholder="Mã model *" required /></div>
                <div class="mb-2"><input name="pointVal" type="number" step="1000" class="form-control form-control-sm" placeholder="Giá trị khuyến mại *" required /></div>
                <div class="mb-3"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm model</button>
            </form>
        </div></div>
    </div>
</div>
