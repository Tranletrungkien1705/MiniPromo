@model List<DiscountCode>
@{ ViewData["Title"] = "Mã giảm giá"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Mã giảm giá</h5>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Kiểu giảm</th><th class="text-end">Giá trị</th><th class="text-center">Lượt còn</th><th>Hiệu lực</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr style="cursor:pointer" onclick="location.href='/DiscountCode/Detail/@c.Id'">
                    <td class="fw-semibold">@c.Code</td>
                    <td class="small">@Ui.DiscountCodeTypeText(c.DiscountType)</td>
                    <td class="text-end small">@(c.DiscountType == DiscountCodeType.Percent ? c.DiscountAmount.ToString("N0") + "%" : Ui.Money(c.DiscountAmount))</td>
                    <td class="text-center small">@c.RemainQty</td>
                    <td class="small">@c.EffectDateFrom.ToString("dd/MM/yyyy") – @c.EffectDateTo.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (c.Enabled) { <span class="badge bg-success">Đang bật</span> } else { <span class="badge bg-secondary">Đang tắt</span> }
                        @if (c.IsLiveNow) { <span class="badge bg-info">Hiệu lực</span> }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có mã giảm giá.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Tạo mã giảm giá</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="row g-2 mb-2">
                    <div class="col-6"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã *" required /></div>
                    <div class="col-6">
                        <select name="discountType" class="form-select form-select-sm">
                            <option value="1">Giảm theo %</option>
                            <option value="2">Giảm số tiền</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small text-muted">Giá trị giảm</label><input name="discountAmount" type="number" step="0.01" value="10" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Số lượt</label><input name="remainQty" type="number" min="0" value="100" class="form-control form-control-sm" /></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small text-muted">Hiệu lực từ</label><input name="effectDateFrom" type="date" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Đến</label><input name="effectDateTo" type="date" class="form-control form-control-sm" /></div>
                </div>
                <div class="mb-3"><textarea name="description" class="form-control form-control-sm" rows="2" placeholder="Mô tả"></textarea></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo</button>
            </form>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Kiểm tra mã giảm giá</h6>
            <form asp-action="Check" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã giảm giá *" required /></div>
                <div class="mb-2"><input name="orderAmount" type="number" step="0.01" class="form-control form-control-sm" placeholder="Giá trị đơn hàng" /></div>
                <button class="btn btn-outline-primary w-100"><i class="bi bi-check2-circle me-1"></i>Kiểm tra</button>
            </form>
        </div></div>
    </div>
</div>