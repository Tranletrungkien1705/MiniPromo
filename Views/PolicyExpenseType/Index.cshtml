@model List<PolicyExpenseType>
@using MiniPromo.Models
@{ ViewData["Title"] = "Tích điểm theo loại chi phí"; var types = (List<ExpenseType>)ViewBag.ExpenseTypes; var curPolicy = ViewBag.PolicyNo as string; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Chính sách đối tượng tích điểm dịch vụ</h5>
    <form method="get" class="d-flex gap-2">
        <input name="policyNo" value="@curPolicy" class="form-control form-control-sm text-uppercase" placeholder="Lọc theo mã chính sách" style="width:220px" />
        <button class="btn btn-outline-primary btn-sm"><i class="bi bi-funnel me-1"></i>Lọc</button>
    </form>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr>
                <th>Mã chính sách</th><th>Loại chi phí</th><th class="text-center">Điểm</th>
                <th class="text-end">Tỷ lệ</th><th class="text-center">Chiết khấu</th><th class="text-center">Trạng thái</th>
            </tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold small">@p.PolicyExpenseTypeNo</td>
                    <td><span class="fw-semibold">@p.ExpenseType</span> <span class="text-muted small">@p.ExpenseTypeNameActual</span></td>
                    <td class="text-center small">
                        @if (p.FlagPoint) { <span class="badge bg-success">Tích điểm</span> }
                        @if (p.FlagPointRank) { <span class="badge bg-info">Xét hạng</span> }
                        @if (p.FlagCountService) { <span class="badge bg-secondary">Lượt DV</span> }
                    </td>
                    <td class="text-end">@p.AmountRate.ToString("N2")</td>
                    <td class="text-center">@if (p.FlagDiscount) { <span>@p.DiscountRate.ToString("N2")%</span> } else { <span class="text-muted">—</span> }</td>
                    <td class="text-center"><span class="badge bg-@(p.FlagActive ? "success" : "secondary")">@(p.FlagActive ? "Đang bật" : "Tạm dừng")</span></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có dòng chính sách.</td></tr> }
            </tbody>
        </table>
    </div></div></div>

    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Lưu chính sách cho một loại chi phí</h6>
            <form asp-action="Save" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="policyExpenseTypeNo" value="@curPolicy" class="form-control form-control-sm text-uppercase" placeholder="Mã chính sách *" required /></div>
                <div class="mb-2"><input name="expenseType" class="form-control form-control-sm text-uppercase" placeholder="Mã loại chi phí *" required list="etList" /><datalist id="etList">@foreach (var t in types) { <option value="@t.Code">@t.Name</option> }</datalist></div>
                <div class="mb-2"><input name="expenseTypeNameActual" class="form-control form-control-sm" placeholder="Tên loại chi phí (hiển thị)" /></div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small text-muted">Tỷ lệ tích điểm</label><input name="amountRate" type="number" step="0.01" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Điểm tối đa tích luỹ</label><input name="maxAccumulationPoint" type="number" step="0.01" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Điểm tối đa/lượt xét hạng</label><input name="maxRankReviewPoint" type="number" step="0.01" value="0" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Tỉ lệ chiết khấu (%)</label><input name="discountRate" type="number" step="0.01" value="0" class="form-control form-control-sm" /></div>
                </div>
                <div class="d-flex flex-wrap gap-3 mb-2 small">
                    <label class="form-check"><input class="form-check-input" type="checkbox" name="flagPoint" value="true" checked /> Tích điểm</label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" name="flagPointRank" value="true" /> Xét hạng</label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" name="flagCountService" value="true" /> Tính lượt DV</label>
                    <label class="form-check"><input class="form-check-input" type="checkbox" name="flagDiscount" value="true" /> Chiết khấu DV</label>
                </div>
                <div class="mb-3"><textarea name="remark" class="form-control form-control-sm" rows="2" placeholder="Ghi chú"></textarea></div>
                <button class="btn btn-primary w-100"><i class="bi bi-save me-1"></i>Lưu chính sách</button>
                <div class="form-text">Lưu theo cơ chế "xoá sạch rồi ghi lại" cho đúng mã chính sách.</div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Danh mục loại chi phí</h6>
            <form asp-action="CreateExpenseType" method="post" class="mb-2">@Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-7"><input name="name" class="form-control form-control-sm" placeholder="Tên loại chi phí *" required /></div>
                    <div class="col-5"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã" /></div>
                </div>
                <button class="btn btn-outline-primary btn-sm w-100 mt-2"><i class="bi bi-plus-lg me-1"></i>Thêm loại chi phí</button>
            </form>
            <table class="table table-sm mb-0">
                <tbody>
                @foreach (var t in types)
                {
                    <tr>
                        <td class="small fw-semibold">@t.Code</td>
                        <td class="small">@t.Name</td>
                        <td class="text-end">
                            <form asp-action="SetExpenseTypeActive" method="post" class="d-inline">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <input type="hidden" name="active" value="@(!t.FlagActive)" />
                                <button class="btn btn-sm @(t.FlagActive ? "btn-outline-secondary" : "btn-outline-success")" style="padding:1px 8px">@(t.FlagActive ? "Tạm dừng" : "Bật")</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (types.Count == 0) { <tr><td class="text-center text-muted py-3" colspan="3">Chưa có loại chi phí.</td></tr> }
                </tbody>
            </table>
        </div></div>

        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Tra cứu quy tắc tích điểm</h6>
            <form asp-action="Calc" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="expenseType" class="form-control form-control-sm text-uppercase" placeholder="Mã loại chi phí *" required /></div>
                <div class="mb-3"><input name="amount" type="number" step="0.01" class="form-control form-control-sm" placeholder="Số tiền dịch vụ" /></div>
                <button class="btn btn-outline-primary w-100"><i class="bi bi-calculator me-1"></i>Tra cứu</button>
            </form>
        </div></div>
    </div>
</div>