@model List<PolicyMoneyToPoint>
@{ ViewData["Title"] = "Quy đổi tiền → điểm"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Chính sách quy đổi tiền dịch vụ → điểm</h5>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên</th><th>Hiệu lực</th><th class="text-center">Hạng thẻ</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                var (t, css) = Ui.PolicyMoneyToPoint(p.Status);
                <tr style="cursor:pointer" onclick="location.href='/PolicyMoneyToPoint/Detail/@p.Id'">
                    <td class="fw-semibold small">@p.Code</td>
                    <td class="fw-semibold">@p.Name</td>
                    <td class="small text-muted">@p.EffDateStart.ToString("dd/MM/yyyy") – @p.EffDateEnd.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@p.Details.Count</td>
                    <td><span class="badge bg-@css">@t</span></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có chính sách.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3">Tạo chính sách quy đổi</h6>
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="name" class="form-control form-control-sm" placeholder="Tên chính sách *" required /></div>
                <div class="mb-2"><input name="code" class="form-control form-control-sm text-uppercase" placeholder="Mã (tự sinh)" /></div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small text-muted">Hiệu lực từ</label><input name="effDateStart" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                    <div class="col-6"><label class="form-label small text-muted">Đến</label><input name="effDateEnd" type="date" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                </div>
                <div class="mb-3"><textarea name="remark" class="form-control form-control-sm" rows="2" placeholder="Ghi chú"></textarea></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo</button>
            </form>
        </div></div>
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Quy đổi thử</h6>
            <form asp-action="Calc" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="cardType" class="form-control form-control-sm text-uppercase" placeholder="Hạng thẻ *" required /></div>
                <div class="mb-2"><input name="amount" type="number" step="0.01" class="form-control form-control-sm" placeholder="Số tiền dịch vụ" /></div>
                <div class="mb-3"><input name="at" type="date" class="form-control form-control-sm" /></div>
                <button class="btn btn-outline-primary w-100"><i class="bi bi-calculator me-1"></i>Quy đổi</button>
            </form>
        </div></div>
    </div>
</div>
