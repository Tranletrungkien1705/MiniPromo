@model List<BirthdayVoucherReconRow>
@{ ViewData["Title"] = "Đối soát voucher sinh nhật"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Đối soát voucher sinh nhật</h5>
    <a href="/BirthdayVoucher" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Về danh sách</a>
</div>
<div class="card"><div class="card-body">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Chương trình</th><th>Hạng thẻ</th><th class="text-end">Đã phát</th><th class="text-end">Điểm đã phát</th><th class="text-end">Điểm còn lại</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td class="small"><b>@r.PolicyCode</b> · @r.PolicyName</td>
                <td class="fw-semibold small">@r.CardType</td>
                <td class="text-end">@r.Issued</td>
                <td class="text-end">@r.PointIssued.ToString("N0")</td>
                <td class="text-end fw-bold" style="color:#db2777">@r.PointRemain.ToString("N0")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu.</td></tr> }
        </tbody>
    </table>
</div></div>