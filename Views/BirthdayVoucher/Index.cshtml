@model List<BirthdayVoucher>
@{ ViewData["Title"] = "Voucher sinh nhật"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Voucher sinh nhật</h5>
    <a href="/BirthdayVoucher/Reconciliation" class="btn btn-sm btn-outline-primary"><i class="bi bi-clipboard-check me-1"></i>Đối soát</a>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã voucher</th><th>Hội viên</th><th>Hạng thẻ</th><th class="text-end">Điểm</th><th>Hạn dùng</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var v in Model)
            {
                var (t, css) = v.IsExpired ? ("Hết hạn", "dark") : (v.IsUsable ? ("Khả dụng", "success") : ("Hết lượt/điểm", "warning"));
                <tr style="cursor:pointer" onclick="location.href='/BirthdayVoucher/Detail/@v.Id'">
                    <td class="fw-semibold small">@v.VoucherNo</td>
                    <td>@v.MemberNo</td>
                    <td class="small text-muted">@v.CardTypeUse</td>
                    <td class="text-end small">@v.PointVCTotal.ToString("N0")</td>
                    <td class="small text-muted">@v.PointExpiryDate.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-@css">@t</span></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có voucher sinh nhật.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Phát voucher sinh nhật</h6>
            <form asp-action="Issue" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="memberNo" class="form-control form-control-sm" placeholder="Mã hội viên *" required /></div>
                <div class="mb-2"><input name="cardNo" class="form-control form-control-sm" placeholder="Số thẻ" /></div>
                <div class="mb-2"><input name="cardType" class="form-control form-control-sm text-uppercase" placeholder="Hạng thẻ *" required /></div>
                <div class="mb-2"><label class="form-label small text-muted">Ngày sinh hội viên</label><input name="dateOfBirth" type="date" class="form-control form-control-sm" required /></div>
                <div class="mb-3"><label class="form-label small text-muted">Ngày xét (mặc định hôm nay)</label><input name="at" type="date" class="form-control form-control-sm" /></div>
                <button class="btn btn-primary w-100"><i class="bi bi-gift me-1"></i>Phát voucher</button>
            </form>
            <div class="small text-muted mt-2">Mỗi hội viên chỉ được phát 1 voucher/năm, do đại lý SUPPORT phát hành.</div>
        </div></div>
    </div>
</div>