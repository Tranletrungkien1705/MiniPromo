@model List<Campaign>
@{ ViewData["Title"] = "Chiến dịch"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên</th><th>Thời gian</th><th class="text-center">Giải</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                var (t, css) = Ui.Camp(c.Status);
                <tr style="cursor:pointer" onclick="location.href='/Campaign/Detail/@c.Id'">
                    <td class="fw-semibold small">@c.Code</td><td>@c.Name</td>
                    <td class="small text-muted">@c.FromDate.ToString("dd/MM") – @c.ToDate.ToString("dd/MM/yy")</td>
                    <td class="text-center">@c.Prizes.Count</td>
                    <td><span class="badge bg-@css">@t</span></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có chiến dịch.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Tạo chiến dịch</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên chiến dịch *" required /></div>
            <div class="mb-2"><input name="code" class="form-control text-uppercase" placeholder="Mã công khai (tự sinh)" /></div>
            <div class="mb-2"><textarea name="description" class="form-control" rows="2" placeholder="Mô tả"></textarea></div>
            <div class="row g-2 mb-2">
                <div class="col-6"><label class="form-label small text-muted">Từ</label><input name="fromDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                <div class="col-6"><label class="form-label small text-muted">Đến</label><input name="toDate" type="date" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            </div>
            <div class="mb-3"><label class="form-label small text-muted">Trọng số "trượt" <i class="bi bi-info-circle" title="Càng cao càng khó trúng"></i></label><input name="loseWeight" type="number" value="100" class="form-control form-control-sm" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo</button>
        </form>
    </div></div></div>
</div>
