@model List<AvailablePromotionRow>
@{
    ViewData["Title"] = "Ưu đãi khả dụng cho thẻ";
    string cardType = ViewBag.CardType as string ?? "";
    string dealerCode = ViewBag.DealerCode as string ?? "";
    DateTime? at = ViewBag.At as DateTime?;
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="fw-bold mb-0">Ưu đãi khả dụng cho hội viên / thẻ</h5>
    <a href="/CardPromotionProgram" class="btn btn-sm btn-outline-primary"><i class="bi bi-credit-card-2-front me-1"></i>Chương trình theo loại thẻ</a>
</div>
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Kết quả tra cứu</h6>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã</th><th>Tên chương trình</th><th>Hiệu lực</th><th class="text-center">Hạn mức</th><th class="text-center">Đã dùng</th><th class="text-center">Còn lại</th><th class="text-center">Sinh nhật</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr style="cursor:pointer" onclick="location.href='/CardPromotionProgram/Detail/@r.CardPromotionProgramId'">
                    <td class="fw-semibold small">@r.ProgramCode</td>
                    <td>@r.ProgramName</td>
                    <td class="small text-muted">từ @r.EffDateStart.ToString("dd/MM/yy")</td>
                    <td class="text-center">@r.QtyPr</td>
                    <td class="text-center text-muted">@r.QtyPrUsed</td>
                    <td class="text-center fw-semibold text-success">@r.QtyRemain</td>
                    <td class="text-center">
                        @if (r.FlagShow == 1) { <span class="badge bg-warning text-dark">Đang mở</span> }
                        else { <span class="text-muted small">—</span> }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa tra cứu hoặc không có ưu đãi khả dụng.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Tra cứu theo thẻ</h6>
            <form asp-action="Lookup" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><input name="cardType" value="@cardType" class="form-control form-control-sm text-uppercase" placeholder="Loại thẻ (VD: GOLD) *" required /></div>
                <div class="mb-2"><input name="dealerCode" value="@dealerCode" class="form-control form-control-sm text-uppercase" placeholder="Mã đại lý của thẻ (VD: DLCP01)" /></div>
                <div class="mb-3"><label class="form-label small text-muted">Ngày tra cứu</label><input name="at" type="date" value="@((at ?? DateTime.Today).ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
                <button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </form>
            <p class="text-muted small mt-3 mb-0">Liệt kê các chương trình khuyến mại theo loại thẻ đang hiệu lực mà thẻ này còn hạn mức ưu đãi (nguồn <code>Crd_Card_GetForPromotion</code>).</p>
        </div></div>
    </div>
</div>
