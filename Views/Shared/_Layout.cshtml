@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniPromo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#db2777; --accent2:#be185d; --sidebar:#1f0f1a; }
        body { font-size:14px; background:#fdf2f8; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:236px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#f9a8d4; }
        .sidebar .nav-link { color:#a98ba0; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(219,39,119,.34); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#5c4152; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #f3d9e7; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(40,2,25,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #eee; }
        .stat-num { font-size:25px; font-weight:800; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-gift-fill"></i> Mini<span>Promo</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <div class="nav-section">Khuyến mãi</div>
            <a class="nav-link @(Nav("Campaign"))" href="/Campaign"><i class="bi bi-megaphone"></i> Chiến dịch</a>
            <a class="nav-link @(Nav("Entry"))" href="/Entry"><i class="bi bi-ticket-perforated"></i> Lượt quay &amp; giải</a>
            <a class="nav-link @(Nav("Play"))" href="/Play"><i class="bi bi-dice-5"></i> Trang quay số</a>
            <a class="nav-link @(Nav("VoucherProgram"))" href="/VoucherProgram"><i class="bi bi-tags"></i> Chương trình voucher</a>
            <a class="nav-link @(Nav("CarPromotion"))" href="/CarPromotion"><i class="bi bi-car-front"></i> KM mua xe mới</a>
            <a class="nav-link @(Nav("CarRecommend"))" href="/CarRecommend"><i class="bi bi-people"></i> Giới thiệu xe</a>
            <a class="nav-link @(Nav("PromotionProgram"))" href="/PromotionProgram"><i class="bi bi-percent"></i> Chương trình khuyến mại</a>
            <a class="nav-link @(Nav("CardPromotionProgram"))" href="/CardPromotionProgram"><i class="bi bi-credit-card-2-front"></i> KM theo loại thẻ</a>
            <a class="nav-link @(Nav("BirthdayPolicy"))" href="/BirthdayPolicy"><i class="bi bi-cake2"></i> Điểm sinh nhật</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-building"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#5c4152;font-size:11px">Chiến dịch · giải · quay số · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo Khuyến mãi")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
